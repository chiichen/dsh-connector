{
  "name": "@dsh-connector/core",
  "version": "0.1.0",
  "description": "Core contracts and stateless context definitions for dsh-connector",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "oxlint": "oxlint",
    "oxfmt": "oxfmt --check"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.9.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
