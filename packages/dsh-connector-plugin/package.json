{
  "name": "dsh-connector-plugin",
  "version": "0.1.0",
  "description": "Unified DeepSeek Harness (dsh) plugin for external service connectors",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "oxlint": "oxlint",
    "oxfmt": "oxfmt --check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@dsh-connector/core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.9.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0-0 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-brand": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-session-title": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-storage": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=24.20.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
