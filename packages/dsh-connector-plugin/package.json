{
  "name": "dsh-connector-plugin",
  "version": "0.2.0",
  "description": "Unified DeepSeek Harness (dsh) plugin for external service connectors",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:dsh-host": "vitest run --config vitest.host.config.mts",
    "lint": "eslint .",
    "oxlint": "oxlint",
    "oxfmt": "oxfmt --check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@dsh-connector/connector-dingtalk": "workspace:*",
    "@dsh-connector/connector-discord": "workspace:*",
    "@dsh-connector/connector-feishu": "workspace:*",
    "@dsh-connector/connector-qq": "workspace:*",
    "@dsh-connector/connector-slack": "workspace:*",
    "@dsh-connector/connector-telegram": "workspace:*",
    "@dsh-connector/connector-wecom": "workspace:*",
    "@dsh-connector/connector-weixin": "workspace:*",
    "@dsh-connector/connector-whatsapp": "workspace:*",
    "@dsh-connector/core": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@tsdown/css": "0.23.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "happy-dom": "^20.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0-0 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-brand": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-session-title": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-storage": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-0 <0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.2.3-0",
    "node": ">=24.20.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  }
}
