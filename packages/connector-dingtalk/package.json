{
  "name": "@dsh-connector/connector-dingtalk",
  "version": "0.1.0",
  "description": "DingTalk robot connector (Stream WebSocket & Outgoing Webhook + OpenAPI v1.0) for dsh-connector",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "oxlint": "oxlint",
    "oxfmt": "oxfmt --check"
  },
  "dependencies": {
    "@dsh-connector/core": "workspace:*",
    "zod": "4.6.6"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
