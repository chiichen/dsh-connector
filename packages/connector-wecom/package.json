  },
  "dependencies": {
    "@dsh-connector/core": "workspace:*",
    "ws": "8.23.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  },
  "engines": {
    "node": ">=24.20.0"
